  "contexts": [
    {
      "chunk_id": "c-a1246adb35925d19582e623b11c2aad0cd4a58557eae37e0beb5354ce7f5cd6b",
      "document_id": "hr-handbook",
      "start": 15360,
      "end": 15616,
      "text": "는지를 확인한 뒤 정정 범위를 정한다. 정보 확인을 위해 문의한 내용은 재택 신청의 해당 항목\n과 연결하되, 기기의 비밀번호나 내부 문서 내용을 신청 설명에 적게 하지 않는다. RM-03@v4의 \n회사 지급 기기 사용 조건은 정보 정정 과정에서도 유지하며, 지급 여부를 확인하지 못한 기기를 임\n의로 확인 완료 상태로 바꾸지 않는다. 문의자가 기기 정보의 정정만 요청한 경우에는 이를 새로운\n 재택 날짜 신청이나 기존 승인 취소로 처리하지 않는다.\n기기 정보",
      "pages": [
        {
          "page": 10,
          "canonical_start": 15360,
          "canonical_end": 15616,
          "page_start": 389,
          "page_end": 645
        }
      ],
      "heading_path": [
        "제3장 재택근무의 신청과 운영 [RM]"
      ],
      "source_fingerprint": "b5abf56d9dbe9d07d7ce8414d2af39de327afd4fb2731d7ecac86bf840765700"
    },
    {
      "chunk_id": "c-75f678b75e5f15dfe8dc27a37a45b7a368426e19088baae0083823c549c0d724",
      "document_id": "hr-handbook",
      "start": 12288,
      "end": 12544,
      "text": " 승인된 근무일로 등록하지 \n않는다.\nRM-03 기기와 내부 문서 접근\n재택근무 시 회사 지급 기기와 회사 VPN을 사용한다. 공용 컴퓨터로 내부 문서에 접근할 수 없다.\n기기 정보의 확인은 회사 지급 기기와 신청자의 현재 사용 기기가 연결되어 있는지를 대조하는 과\n정으로 기록한다. 연결 정보가 잘못 표시되었다는 문의를 받으면 오류가 있는 항목과 실제 확인 결\n과를 구별해 남기고, 단순한 정보 정정 문의를 개인 기기 사용 허용 요청으로 처리하지 않는다.\n",
      "pages": [
        {
          "page": 8,
          "canonical_start": 12288,
          "canonical_end": 12544,
          "page_start": 538,
          "page_end": 794
        }
      ],
      "heading_path": [
        "제3장 재택근무의 신청과 운영 [RM]"
      ],
      "source_fingerprint": "b5abf56d9dbe9d07d7ce8414d2af39de327afd4fb2731d7ecac86bf840765700"
