    },
    {
      "chunk_id": "c-9535b9e31fc72093eeb0658913d80db0d126b605f7ba251f771ff95ccd1b6647",
      "document_id": "hr-handbook",
      "start": 209,
      "end": 376,
      "text": "제1장 생일 특별휴가와 포인트의 구분 [BD]\n제1절 적용 기준 [BD-S1]\nBD-01 적용 대상과 부여 일수\n입사 후 3개월이 지난 재직자는 매년 생일 특별휴가 1일을 신청할 수 있다. 수습 중인 직원은 대상\n에서 제외한다.\n담당자는 신청 내역에 표시된 재직 기간과 수습 구분을 각각 확인한다. ",
      "pages": [
        {
          "page": 1,
          "canonical_start": 209,
          "canonical_end": 376,
          "page_start": 209,
          "page_end": 376
        }
      ],
